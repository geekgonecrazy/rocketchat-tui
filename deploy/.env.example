# Copy to .env next to docker-compose.yml and adjust as needed.

# Rocket.Chat release to run.
RELEASE=8.0.1
MONGODB_VERSION=8.0

# Where the server is reachable. Must match the address you give rctui, or
# websocket connections are rejected by the origin check.
ROOT_URL=http://localhost:3000
HOST_PORT=3000

# Seeded on first boot only. Change the password before exposing this anywhere.
ADMIN_USERNAME=admin
ADMIN_PASS=changeme123
ADMIN_EMAIL=admin@example.com
